# Copy to /etc/hydrophone/node.env on the Pi. The service role key bypasses
# RLS; keep this file root-readable only (chmod 600).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides of node.yaml
