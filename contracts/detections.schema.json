{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrecos.local/contracts/detections.schema.json",
  "title": "detections",
  "description": "One detected sound event in public.detections. A row is a call, a boat, or an unknown sound, not an individual fish. label is free text; common values are sturgeon_thunder, drum_knock, toadfish_boatwhistle, boat, and unknown. review_status defaults to unreviewed. clip_path, when set, is an object key in the Storage bucket audio. Realtime is enabled on this table. Inserts use the service role.",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "start_time", "end_time", "label"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "node_id": { "type": "string", "minLength": 1 },
    "segment_id": { "type": ["string", "null"], "format": "uuid" },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": "string", "format": "date-time" },
    "label": { "type": "string", "minLength": 1 },
    "species_id": { "type": ["string", "null"], "minLength": 1 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "model_name": { "type": ["string", "null"] },
    "model_version": { "type": ["string", "null"] },
    "freq_low_hz": { "type": ["number", "null"], "minimum": 0 },
    "freq_high_hz": { "type": ["number", "null"], "minimum": 0 },
    "clip_path": {
      "type": ["string", "null"],
      "description": "Object key in bucket audio for the extracted clip, or null."
    },
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "confirmed", "rejected"],
      "default": "unreviewed"
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
